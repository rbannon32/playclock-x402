# Play Clock — environment configuration
#
# Copy to `.env` at the repo root for local dev (`.env` is gitignored), or feed
# these as Cloud Run environment variables / Secret Manager references in prod.
#
# Every variable maps 1:1 to a field on api.core.config.Settings. Every one has
# a default, so an empty .env still boots a working local dev server with an
# in-memory store, no LLM, and payments disabled.
#
# Tech spec §10.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Human-facing product name (appears in /v1/catalog and the web UI).
APP_NAME=Play Clock

# Deployment environment: dev | staging | prod. Affects logging verbosity only.
ENV=dev

# ---------------------------------------------------------------------------
# Storage (api.core.store)
# ---------------------------------------------------------------------------

# memory   = in-process dict store. No credentials. Tests, CI, local dev.
# firestore = google.cloud.firestore.AsyncClient. Requires ADC + a project.
STORE_BACKEND=memory

# GCP project id. Required when STORE_BACKEND=firestore. Also used by Vertex AI.
GOOGLE_CLOUD_PROJECT=

# Region for Vertex AI, read from the environment by the google-genai SDK.
# MUST be `global` when MODEL_ID is a Gemini 3 id: gemini-3.7-flash resolves only
# at locations/global and 404s in us-east4 and us-central1 (verified 2026-08-28).
# This does not affect Firestore (location fixed at database creation) or Cloud
# Run (region is a deploy flag).
GOOGLE_CLOUD_LOCATION=global

# ---------------------------------------------------------------------------
# Analysis engine (api/agents/, wave 3)
# ---------------------------------------------------------------------------

# deterministic = build responses straight from the stats tools, no LLM.
#                 Hermetic; used by tests, CI, and as the schema-safe fallback.
# narrated      = the deterministic body, then ONE tool-free Gemini call that
#                 rewrites only its prose fields. Every number in the new prose
#                 must already be in the body and every name must already be
#                 named there (checked in Python, api/agents/narrator.py), so
#                 the answer stays grounded while reading like an analyst wrote
#                 it. A few seconds, not the ~55s of the full pipeline; on a
#                 timeout or model failure the untouched body is served and
#                 meta.model stays null.
# adk           = the real ADK SequentialAgent pipeline via Vertex AI.
ENGINE=deterministic

# ENGINE=narrated only: seconds to wait for the prose rewrite before serving
# the deterministic body as is. Settlement precedes the response, so this plus
# the deterministic build must stay under the client's deadline.
NARRATOR_TIMEOUT_SECONDS=20

# Attempts per Vertex request, including the first, when it answers 408/429/5xx
# (google-genai's own backoff: 2s, doubling, 30s ceiling). 1 disables. The SDK
# retries nothing by default, so before this a single 429 in a ~9-call board
# failed the whole run and the pipeline started over from the first call —
# a third of the model bill, in the ingest logs. The ingest job runs 6: nothing
# is waiting on it. Keep the api's lower; a payer is.
MODEL_RETRY_ATTEMPTS=4

# Gemini thinking level for every Vertex call. Unset = the model's own default,
# which is what this project ships. 'low' caps internal reasoning.
#
# Thinking bills at the OUTPUT rate and is most of it: 562 thinking tokens
# against 154 of answer on a board prompt, five runs out of five. Capping it
# looked free -- same rows, same answer length -- and took the golden suite from
# 21/23 to 11/23, almost entirely "quotes <number> which is in neither
# stats_cited nor the body". Thinking is what makes the model track which
# numbers came from a tool. Leave it unset (DESIGN_NOTES §27).
# MODEL_THINKING_LEVEL=low

# When the ADK pipeline fails, answer from the deterministic engine instead of
# returning a 500. Vertex answers 429 whenever calls bunch up — ingest/precompute
# already waits minutes between attempts for exactly that reason, which a paid
# request cannot — so under advertised load the choice is a degraded answer or
# an outage.
#
# The trade is not free: a 500 settles nothing, a fallback answer is billed. It
# is worth it only because the fallback is a real answer — every number comes
# from the ingested store, and it says what it is (meta.model is null). Set
# false to prefer the outage.
ENGINE_FALLBACK=true

# Ingest job only. Score every board precompute warms with one Gemini call
# against the rubric in ingest/judge.py and write it to quality/{key} beside
# the cached body. The rule-based value gate (api/evals/quality.py) always
# runs; this adds the judgement a rule cannot make (bland vs. sharp). A
# flagged board is logged on the "board quality flagged" line, never refused —
# a cold board 503s every caller, which is worse. Needs Vertex credentials.
QUALITY_JUDGE=false

# Per-client, per-instance cap on the FREE routes only. Payment is the limit on
# the paid ones. Three free routes read Firestore per call, so an advert or a
# crawler is otherwise an unbounded bill against a $50/mo budget. 0 disables.
FREE_RATE_LIMIT_PER_MINUTE=120

# Production only: the exact number of addresses a verified proxy appends to
# X-Forwarded-For. Never infer it from the first value: clients can supply that
# prefix. A nonzero free limit in ENV=prod refuses to start without this value.
# Direct Cloud Run does not document a stable X-Forwarded-For suffix contract;
# put the service behind a sanitizing proxy/load balancer and verify its header
# behavior before setting this.
TRUSTED_PROXY_HOPS=0

# Which endpoints run the google_search research agent, overriding the
# per-endpoint defaults in api/agents/prompts.py. The search half is the slow,
# high-variance one, and the personalized endpoints settle BEFORE they return —
# so a caller that times out has paid for nothing. This makes the open latency
# question (TODO.md §3) an env experiment rather than a code change:
#
#   RESEARCH_ENDPOINTS=none              measure the pipeline with no search
#   RESEARCH_ENDPOINTS=trending,report   only the cached boards pay for it
#
# Unset keeps today's behaviour.
# RESEARCH_ENDPOINTS=

# Vertex AI model id for the ADK agents. Pin the exact id at build time.
# Verified live 2026-08-28: gemini-3.7-flash works, but ONLY with
# GOOGLE_CLOUD_LOCATION=global (see above). Regional us-east4 offers only
# gemini-2.5-flash / -flash-lite / -pro, and 2.5-flash retires ~Oct 2026,
# inside the challenge window — so global + Gemini 3 is the supported pairing.
MODEL_ID=gemini-3.7-flash

# Route google-genai through Vertex AI rather than the public Gemini API.
# Read directly by the google-genai SDK / ADK, not by Settings.
# (GOOGLE_GENAI_USE_VERTEXAI still works but is deprecated since ADK 2.3.)
GOOGLE_GENAI_USE_ENTERPRISE=true

# ---------------------------------------------------------------------------
# x402 payments (api/x402/, wave 2)
# ---------------------------------------------------------------------------

# disabled = no payment gate at all (unit tests, local hacking).
# mock     = accept a magic test header instead of a real payment (browser dev).
# live     = verify/settle against the real facilitator.
X402_MODE=disabled

# Which Algorand network payments settle on: testnet | mainnet.
# Build and validate on testnet; flip to mainnet for launch.
X402_NETWORK=testnet

# Algorand address that receives USDC. ONE address for every endpoint — the
# challenge's "Composite" entry type requires a single payTo.
X402_PAY_TO=

# Facilitator base URL used for verify/settle. Empty = the GoPlausible
# facilitator (https://facilitator.goplausible.xyz), which the challenge
# REQUIRES for leaderboard attribution. The x402 SDK's own default
# (https://x402.org/facilitator) is deliberately never used — settling there
# would forfeit challenge credit. Live mode requires https.
X402_FACILITATOR_URL=

# USDC ASA id for the active network. 0 = use the verified per-network
# defaults baked into the payment layer (MainNet 31566704, TestNet 10458941,
# 6 decimals). Only set this to override.
X402_ASSET_ID=0

# Public base URL used as the resource URL in payment requirements.
# CRITICAL: the facilitator PERMANENTLY catalogs the first resource URL it
# settles for — never let live mode see localhost. Live mode refuses to start
# if this resolves to a loopback host.
X402_RESOURCE_BASE_URL=

# Tag included in payment metadata for challenge leaderboard attribution.
# Do not change — the challenge requires this exact value.
X402_CHALLENGE_TAG=x402-global-challenge

# Bazaar merchant identity — the `x402-merchant` extension on every 402.
# Optional to the protocol, load-bearing in practice: with no merchant block the
# catalogue and leaderboard fall back to scraping the resource origin's root for
# a <title> and /apple-touch-icon.png, and a host serving neither lists as a
# truncated payTo address. CATEGORIES cannot be guessed at all and is what an
# agent browsing the Bazaar filters on. See DESIGN_NOTES §25.
X402_MERCHANT_NAME=Play Clock
X402_MERCHANT_WEBSITE=https://playclock.xyz
X402_MERCHANT_LOGO=https://api.playclock.xyz/apple-touch-icon.png
X402_MERCHANT_CATEGORIES=fantasy-football,nfl,sports-analytics,api,algorand,x402

# ---------------------------------------------------------------------------
# Upstream data sources (api/data/)
# ---------------------------------------------------------------------------

# Feature flag for ESPN's unofficial endpoints. They are supplemental only and
# degrade to empty on any failure; set false to skip them entirely.
ENABLE_ESPN=true

# Sleeper API base URL. Override only to point tests/fixtures at a fake.
SLEEPER_BASE_URL=https://api.sleeper.app/v1

# ---------------------------------------------------------------------------
# Season & week
# ---------------------------------------------------------------------------

# Active NFL season year.
SEASON=2026

# Force the current NFL week, bypassing schedule-based resolution. Leave empty
# in production; useful for testing and for the gap before ingest has run.
WEEK_OVERRIDE=

# ---------------------------------------------------------------------------
# Prices, in USDC per call (env-tunable for October price experiments)
# ---------------------------------------------------------------------------

PRICE_TRENDING=0.10
PRICE_SLEEPERS=0.20
PRICE_PLAYER=0.10
PRICE_MATCHUP=0.20
PRICE_ROSTER=0.35
PRICE_WAIVERS=0.20
PRICE_REPORT=0.35
PRICE_TEAM_REPORT=0.50
PRICE_DRAFT_BOARD=0.20
PRICE_DRAFT_REPORT=0.50
